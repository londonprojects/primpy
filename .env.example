# Primpy shares the Snip Firebase backend (project: currentlyremote-snip).
# These are public Firebase web-config values (safe to ship to the browser);
# access is controlled by Firestore security rules, not by hiding these.
VITE_FIREBASE_API_KEY=AIzaSyCC5n3CuwHXR2B23UNxNolC-VvZEOdbHI8
VITE_FIREBASE_AUTH_DOMAIN=currentlyremote-snip.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=currentlyremote-snip
VITE_FIREBASE_STORAGE_BUCKET=currentlyremote-snip.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=687299273547
# Web app id — create a Web app in the Firebase console if you don't have one.
VITE_FIREBASE_APP_ID=

# Stripe payments backend shared with Snip (Shipyard Express API).
VITE_API_BASE_URL=http://localhost:3001

# Stripe publishable key. Leave empty to hide the pay-now options (bookings are pay-at-venue).
VITE_STRIPE_PUBLISHABLE_KEY=
