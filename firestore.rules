rules_version = '2';

// Snip — Firestore rules aligned with the React Native app collections.
// Deploy to the SAME project as android/app/google-services.json (project_id) and iOS GoogleService-Info.plist.
// From apps/Snip: npx firebase-tools use <that-project-id> && npx firebase-tools deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userShopId() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && 'chatBarberShopId' in userDoc()
        && userDoc().chatBarberShopId is string
        && userDoc().chatBarberShopId != '';
    }

    // --- User profiles (signup, settings, barber profile, schedule, FCM token) ---
    match /users/{userId} {
      // LIST queries on `users` (e.g. where role in ['barber','admin']) require rules Firestore can
      // reconcile with the query. A role-scoped read here still caused permission-denied for some
      // clients, so any signed-in user may READ user docs. Writes stay owner-only.
      // Do not store payment secrets, etc. on this document — use owner-only paths or subcollections.
      allow read: if signedIn();
      allow write: if isOwner(userId);
    }

    // --- Appointments: customer creates; both customer and barber can read/update own rows ---
    // Primpy (source 'primpy-web') bookings trigger email alerts from Cloud Functions, so they
    // are validated strictly. Recipient emails are never read from this doc (the function looks
    // them up server-side), but who a booking points at (customerId/barberId) is locked here.
    function apptKeysPrimpy() {
      return ['customerId', 'userId', 'barberId', 'barberName', 'serviceId', 'serviceIds', 'serviceName',
        'duration', 'date', 'time', 'price', 'notes', 'status', 'paymentMethod', 'amountPaid',
        'paymentIntentId', 'createdAt', 'source'];
    }
    function apptDateOk(d) { return d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function apptTimeOk(d) { return d.time is string && d.time.matches('^[0-9]{2}:[0-9]{2}$'); }
    function strMax(d, k, n) { return !(k in d) || (d[k] is string && d[k].size() <= n); }
    function isVenue(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.get('role', '') in ['barber', 'admin'];
    }
    function primpyCreateOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(apptKeysPrimpy())
        && d.userId == request.auth.uid
        && d.barberId is string && d.barberId != request.auth.uid && isVenue(d.barberId)
        && d.status == 'scheduled'
        && apptDateOk(d) && apptTimeOk(d)
        && strMax(d, 'barberName', 200) && strMax(d, 'serviceName', 500) && strMax(d, 'serviceId', 200)
        && strMax(d, 'notes', 1000) && strMax(d, 'createdAt', 40)
        && (!('serviceIds' in d) || (d.serviceIds is list && d.serviceIds.size() <= 20))
        && d.price is number && d.price >= 0 && d.duration is number && d.duration > 0 && d.duration <= 1440
        // Money is only ever recorded as paid by the server (from Stripe). A deposit / full
        // payment must reference the Stripe PaymentIntent it was paid with.
        && d.amountPaid == 0
        && d.paymentMethod in ['venue', 'deposit', 'full']
        && (d.paymentMethod == 'venue'
          ? (!('paymentIntentId' in d) || d.paymentIntentId == null)
          : ('paymentIntentId' in d && d.paymentIntentId is string
              && d.paymentIntentId.matches('^pi_[A-Za-z0-9_]{1,200}$')));
    }
    function primpyUpdateOk() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['status', 'date', 'time', 'rescheduledAt',
          'hairReferencePhotos', 'customerReviewId', 'reviewImageUrl'])
        && d.status in ['scheduled', 'confirmed', 'completed', 'cancelled', 'no-show', 'noshow', 'rescheduled']
        && apptDateOk(d) && apptTimeOk(d) && strMax(d, 'rescheduledAt', 40);
    }
    match /appointments/{apptId} {
      allow read: if signedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.barberId == request.auth.uid
      );
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && !('primpyNotified' in request.resource.data)
        && (request.resource.data.get('source', '') != 'primpy-web' || primpyCreateOk());
      allow update: if signedIn() && (
          resource.data.customerId == request.auth.uid ||
          resource.data.barberId == request.auth.uid
        )
        // Nobody can re-point a booking at other people, relabel it, or touch the email claim field.
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['customerId', 'userId', 'barberId', 'source', 'primpyNotified'])
        && (resource.data.get('source', '') != 'primpy-web' || primpyUpdateOk());
      allow delete: if signedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.barberId == request.auth.uid
      );
    }

    // --- Reviews (barber dashboard reads by barberId) ---
    match /reviews/{reviewId} {
      allow read: if signedIn() && resource.data.barberId == request.auth.uid;
      allow create: if signedIn();
      allow update, delete: if signedIn() && resource.data.barberId == request.auth.uid;
    }

    // --- Catalog (booking flow lists services / barbers) ---
    match /services/{docId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /barbers/{docId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // --- Chat threads ---
    match /conversations/{convId} {
      allow read: if signedIn() && (
        resource.data.customerUid == request.auth.uid ||
        resource.data.barberUid == request.auth.uid ||
        resource.data.barberShopId == request.auth.uid ||
        (userShopId() && resource.data.barberShopId == userDoc().chatBarberShopId)
      );

      allow create: if signedIn() && (
        request.resource.data.customerUid == request.auth.uid ||
        request.resource.data.barberUid == request.auth.uid
      );

      allow update: if signedIn() && (
        resource.data.customerUid == request.auth.uid ||
        resource.data.barberUid == request.auth.uid ||
        (userShopId() && resource.data.barberShopId == userDoc().chatBarberShopId)
      );

      match /messages/{msgId} {
        allow read: if signedIn() && (
          get(/databases/$(database)/documents/conversations/$(convId)).data.customerUid
            == request.auth.uid ||
          get(/databases/$(database)/documents/conversations/$(convId)).data.barberUid
            == request.auth.uid ||
          (userShopId() &&
            get(/databases/$(database)/documents/conversations/$(convId)).data.barberShopId
              == userDoc().chatBarberShopId)
        );
        allow create: if signedIn() && (
          get(/databases/$(database)/documents/conversations/$(convId)).data.customerUid
            == request.auth.uid ||
          get(/databases/$(database)/documents/conversations/$(convId)).data.barberUid
            == request.auth.uid ||
          (userShopId() &&
            get(/databases/$(database)/documents/conversations/$(convId)).data.barberShopId
              == userDoc().chatBarberShopId)
        );
        allow update, delete: if false;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
